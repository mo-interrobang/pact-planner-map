if (typeof L === 'undefined') { document.getElementById('oakmap').innerHTML = '<div style="padding:40px;text-align:center;color:#64748b;font-size:12px">Map library failed to load — refresh the page.</div>'; } else {
const oakMap = L.map('oakmap', { scrollWheelZoom: false }).setView([42.62, -83.40], 10);
L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap' }).addTo(oakMap);
OAKLAND.forEach(m => {
  if (!m.lat || !m.lng) return;
  const dc  = !!m.data_center_case;
  const cwa = !!m.cwa_flag;
  const fill = dc ? '#d95926' : (cwa ? '#9085e9' : '#64748b');
  const cm = L.circleMarker([m.lat, m.lng], {
    radius: dc ? 9 : (cwa ? 7 : 5.5),
    color: cwa ? '#9085e9' : fill,
    weight: cwa ? 2.5 : 1.5,
    fillColor: fill,
    fillOpacity: dc ? 0.85 : 0.7
  }).addTo(oakMap);
  const noteFull = m.data_center_notes || m.notes || '';
  const note = noteFull.slice(0, 650);
  cm.bindPopup('<div style="max-width:330px;max-height:260px;overflow-y:auto"><b style="font-size:13px;color:#f1f5f9">' + m.municipality + '</b><br>' +
    '<span style="color:#9085e9;font-size:11px">' + (m.firm || 'Firm unknown') + (m.planner_name ? ' — ' + m.planner_name : '') + '</span><br>' +
    '<span style="font-size:11px;color:#cbd5e1">' + note + (noteFull.length > 650 ? '…' : '') + '</span></div>');
  if (dc) cm.bindTooltip(m.municipality, { permanent: true, direction: 'top', className: 'oak-tt', offset: [0, -9] });
});

const camLayer = L.layerGroup();
CAMERAS.forEach(c => {
  const cm = L.circleMarker([c.lat, c.lng], {
    radius: 3.5,
    color: '#34d399',
    weight: 1,
    fillColor: '#34d399',
    fillOpacity: 0.75
  });
  const opLine = c.operator ? c.operator : 'Operator not specified in source data';
  cm.bindPopup('<div style="max-width:280px"><b style="font-size:12px;color:#f1f5f9">' + (c.brand || 'Camera') + '</b><br>' +
    '<span style="font-size:11px;color:#34d399">' + opLine + '</span><br>' +
    '<span style="font-size:10px;color:#94a3b8">' + (c.zone ? 'Zone: ' + c.zone + ' &nbsp;' : '') + (c.mount ? 'Mount: ' + c.mount : '') + '</span><br>' +
    '<span style="font-size:9px;color:#64748b">Source: deflock.org (OSM node ' + c.id + ')</span></div>');
  cm.addTo(camLayer);
});
camLayer.addTo(oakMap);
const camToggleEl = document.getElementById('camToggle');
if (camToggleEl) {
  camToggleEl.addEventListener('change', () => {
