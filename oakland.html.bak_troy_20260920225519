<style>
/* ── Validated dark palette (reference palette dark column) ── */
:root {
  --surface-0:   #0f172a;
  --surface-1:   #1e293b;
  --surface-2:   #293548;
  --surface-3:   #364560;
  --border:      #334155;
  --text-1:      #f1f5f9;
  --text-2:      #94a3b8;
  --text-3:      #64748b;

  /* Event type colors — reference palette dark slots */
  --c-cwa-hired:      #9085e9;  /* slot 7 violet  — CWA contract begins */
  --c-developer:      #d95926;  /* slot 2 orange  — developer action    */
  --c-cwa-action:     #e66767;  /* slot 8 red     — CWA enables or aids developer */
  --c-community:      #c98500;  /* slot 4 amber   — community/public response */
  --c-protection:     #199e70;  /* slot 3 aqua    — moratorium / denial / resolution */
  --c-legal:          #3987e5;  /* slot 1 blue    — lawsuits / affidavits / consent judgments */
  --c-cwa-terminated: #d55181;  /* slot 5 magenta — CWA fired */
  --c-future:         #5b7ca0;  /* muted blue     — upcoming deadline */
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--surface-0);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  min-height: 100vh;
}

/* ── PAGE HEADER ── */
.page-header {
  padding: 22px 28px 18px;
  background: var(--surface-1);
  border-bottom: 1px solid var(--border);
}
.page-header h1 {
  font-size: 20px;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.25px;
}
.page-header .subtitle {
  font-size: 12.5px;
  color: var(--text-2);
  margin-top: 4px;
  max-width: 700px;
}
.cwa-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  color: #e66767;
  background: rgba(230,103,103,0.15);
  border: 1px solid rgba(230,103,103,0.3);
  border-radius: 4px;
  padding: 1px 6px;
  margin-left: 8px;
  vertical-align: middle;
  letter-spacing: 0.05em;
}

/* ── LEGEND ── */
.legend-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 18px;
  padding: 11px 28px;
  background: var(--surface-1);
  border-bottom: 1px solid var(--border);
  align-items: center;
}
.legend-heading {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-3);
  margin-right: 4px;
}
.leg-item {
  display: flex;
  align-items: center;
  gap: 5px;
  cursor: pointer;
  padding: 3px 8px 3px 5px;
  border-radius: 20px;
  border: 1px solid transparent;
  transition: border-color 0.15s, opacity 0.15s;
  user-select: none;
}
.leg-item:hover { border-color: var(--border); }
.leg-item.off { opacity: 0.3; }
.leg-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.leg-label { font-size: 11.5px; color: var(--text-2); white-space: nowrap; }

/* ── TOP SCROLLBAR (sticky, so you don't have to scroll to the bottom of the
   62-lane chart to reach the native horizontal scrollbar) ── */
.top-scrollbar-wrap {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 28px;
  background: var(--surface-1);
  border-bottom: 1px solid var(--border);
}
.top-scrollbar-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--text-3);
  white-space: nowrap;
}
.jump-btn {
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--text-2);
  cursor: pointer;
  white-space: nowrap;
}
.jump-btn:hover { background: var(--surface-3); color: var(--text-1); }
.top-scrollbar-track {
  position: relative;
  flex: 1;
  height: 12px;
  background: var(--surface-2);
  border-radius: 7px;
  cursor: pointer;
}
.top-scrollbar-thumb {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  min-width: 24px;
  background: var(--text-3);
  border-radius: 7px;
  cursor: grab;
  touch-action: none;
}
.top-scrollbar-thumb:hover, .top-scrollbar-thumb.dragging { background: var(--text-2); }

/* ── THIS WEEK AT A GLANCE ── */
.week-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
  padding: 6px 28px 24px;
}
@media (max-width: 1000px) {
  .week-grid { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
}
.week-day-card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.week-day-card.is-today {
  border-color: #0ea5e9;
  box-shadow: 0 0 0 1px #0ea5e9 inset;
}
.week-day-name {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--text-3);
}
.week-day-date {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text-1);
  margin-top: -4px;
}
.week-event-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.week-event-item {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  font-size: 11.5px;
  line-height: 1.45;
}
.week-event-icon { flex-shrink: 0; margin-top: 2px; }
.week-event-text { color: var(--text-2); }
.week-event-text b { color: var(--text-1); font-weight: 600; }
.week-event-text a { color: #7dd3fc; text-decoration: none; }
.week-event-text a:hover { text-decoration: underline; }
.week-empty { color: var(--text-3); font-size: 11px; font-style: italic; }
.week-packet-link {
  color: #94a3b8;
  text-decoration: none;
  white-space: nowrap;
  font-size: 11px;
  border-bottom: 1px dotted #94a3b8;
}
.week-packet-link:hover { color: #e2e8f0; border-bottom-color: #e2e8f0; }
.week-packet-missing { color: var(--text-3); font-size: 10.5px; font-style: italic; white-space: nowrap; }
.week-alert {
  margin-top: 5px;
  padding: 6px 8px;
  background: rgba(248, 113, 113, 0.12);
  border: 1px solid rgba(248, 113, 113, 0.4);
  border-radius: 6px;
  color: #fca5a5;
  font-size: 11px;
  line-height: 1.4;
}

/* ── MAIN LAYOUT ── */
.scroll-wrap {
  overflow-x: auto;
  padding: 20px 28px 32px;
}
.chart-area {
  min-width: 960px;
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 0;
}

/* ── AXIS ── */
.axis-spacer {
  position: sticky;
  left: 0;
  z-index: 4;
  background: var(--surface-0);
}
.axis-svg-wrap { position: relative; }

/* ── SWIMLANE ── */
.lane {
  display: contents;
}
.lane-header {
  position: sticky;
  left: 0;
  z-index: 4;
  box-shadow: 4px 0 8px -4px rgba(0,0,0,0.4);
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-right: none;
  border-radius: 8px 0 0 8px;
  padding: 14px 14px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-top: 8px;
}
.lane-body {
  border: 1px solid var(--border);
  border-left: 1px solid var(--border);
  border-radius: 0 8px 8px 0;
  background: var(--surface-1);
  position: relative;
  margin-top: 8px;
  overflow: hidden;
}
.lh-county {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--text-3);
}
.lh-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-1);
  margin-top: 1px;
}
.lh-planner {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-2);
  margin-top: 6px;
}
.lh-title {
  font-size: 10.5px;
  color: var(--text-3);
}
.lh-status {
  display: inline-block;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  padding: 2px 6px;
  border-radius: 4px;
  margin-top: 6px;
  width: fit-content;
}
.lh-status.active {
  color: #e66767;
  background: rgba(230,103,103,0.18);
}
.lh-status.terminated {
  color: #d55181;
  background: rgba(213,81,129,0.18);
}

/* ── PATTERN CALLOUT STRIP ── */
.pattern-strip {
  padding: 16px 28px;
  background: rgba(230,103,103,0.06);
  border-bottom: 1px solid rgba(230,103,103,0.22);
}
.pattern-strip-heading {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #e66767;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.pattern-strip-heading::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(230,103,103,0.25);
}
.pattern-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 10px;
}
.pattern-card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-left: 3px solid #e66767;
  border-radius: 6px;
  padding: 10px 12px;
}
.pattern-card-num {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #e66767;
  margin-bottom: 3px;
}
.pattern-card-title {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 4px;
  line-height: 1.3;
}
.pattern-card-body {
  font-size: 11px;
  color: var(--text-2);
  line-height: 1.5;
}
.pattern-card-body strong { color: var(--text-1); font-weight: 600; }
.pattern-card-body em { color: #e66767; font-style: normal; font-weight: 600; }

/* ── TOOLTIP ── */
#tt {
  position: fixed;
  background: #1e293b;
  border: 1px solid #475569;
  border-radius: 10px;
  padding: 13px 16px;
  max-width: 330px;
  pointer-events: none;
  z-index: 9999;
  opacity: 0;
  transition: opacity 0.1s;
  box-shadow: 0 10px 32px rgba(0,0,0,0.5);
}
#tt.show { opacity: 1; }
#tt.pinned { pointer-events: auto; }
.tt-type { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; }
.tt-label { font-size: 13.5px; font-weight: 600; color: #f1f5f9; line-height: 1.3; margin-bottom: 5px; }
.tt-date { font-size: 11px; color: #94a3b8; margin-bottom: 7px; }
.tt-detail { font-size: 12px; color: #cbd5e1; line-height: 1.55; }
.tt-source { font-size: 11px; margin-top: 8px; padding-top: 7px; border-top: 1px solid #334155; }
.tt-source a { color: #5eb1f0; text-decoration: none; }
.tt-source a:hover { text-decoration: underline; }
.tt-pin-hint { font-size: 9.5px; color: #64748b; margin-top: 6px; font-style: italic; }

/* ── NEW-ENTRY MARKER ── */
.new-ring {
  animation: newPulse 1.6s ease-in-out infinite;
}
@keyframes newPulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.25; }
}
.tt-new-badge {
  display: inline-block;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: #1a1500;
  background: #fbbf24;
  border-radius: 3px;
  padding: 1px 5px;
  margin-right: 7px;
  vertical-align: middle;
}

/* ── SEPARATORS ── */
.section-break {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--text-3);
  padding: 16px 28px 4px;
}

/* ── OAKLAND PAGE ADDITIONS ── */
.pv-green { border-left: 3px solid #34d399; }
.pv-green .pattern-card-num { color: #34d399; }
.pv-red { border-left: 3px solid #f87171; }
.pv-red .pattern-card-num { color: #f87171; }
.pattern-card-body a { color: #67e8f9; text-decoration: none; }
.pattern-card-body a:hover { text-decoration: underline; }
.docs-strip { margin: 20px 0 4px; padding: 14px 18px 10px; background: rgba(148,163,184,0.05); border: 1px solid #334155; border-radius: 10px; }
.docs-strip-heading { font-weight: 700; font-size: 13px; margin-bottom: 8px; color: #e2e8f0; }
.docs-strip ul { margin: 0; padding-left: 18px; }
.docs-strip li { font-size: 11.5px; color: #94a3b8; line-height: 1.55; margin-bottom: 6px; }
.docs-strip a { color: #67e8f9; text-decoration: none; }
.docs-strip a:hover { text-decoration: underline; }
.lh-status.none { background: rgba(100,116,139,0.15); color: #94a3b8; border: 1px solid #475569; }
.map-wrap { padding: 8px 28px 34px; }
#oakmap { height: 480px; border-radius: 12px; border: 1px solid #334155; background: #0b1220; }
.map-legend { font-size: 11px; color: #94a3b8; padding: 10px 28px 6px; }
.map-legend .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin: 0 5px 0 14px; vertical-align: middle; }
.leaflet-tile-pane { opacity: 0.82; filter: brightness(0.72) saturate(0.6); }
.leaflet-popup-content-wrapper { background: #1e293b; color: #cbd5e1; border-radius: 8px; }
.leaflet-popup-tip { background: #1e293b; }
.leaflet-popup-content { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; line-height: 1.45; }
.oak-tt { background: rgba(15,23,42,0.85); border: 1px solid #475569; color: #e2e8f0; font-size: 10px; font-weight: 700; border-radius: 4px; padding: 1px 5px; box-shadow: none; }
.oak-tt::before { display: none; }
</style>
</head>
