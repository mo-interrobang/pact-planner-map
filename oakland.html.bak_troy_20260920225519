// ─────────────────────────────────────────────
//  TIME SCALE
// ─────────────────────────────────────────────
const T_START = new Date('2025-04-01');
const T_END   = new Date('2027-04-01');
const T_RANGE = T_END - T_START;
const PX_PER_MONTH = 95; // controls how wide the scrollable chart is — higher = more room per event, more horizontal scrolling (raised Aug 14, 2026: several communities now have many events packed into a single recent month)

function parseDate(str) {
  // Handle YYYY-MM or YYYY-MM-DD
  if (str.length === 7) return new Date(str + '-15');
  return new Date(str);
}

function toX(dateStr, width) {
  const t = parseDate(dateStr);
  return Math.round(((t - T_START) / T_RANGE) * width);
}

function fmtDate(str) {
  const d = parseDate(str);
  if (str.length === 7) return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

// ─────────────────────────────────────────────
//  SHAPE HELPERS
// ─────────────────────────────────────────────
function shape(type, cx, cy, r) {
  switch(type) {
    case 'cwa-hired':      // star
      return starPath(cx, cy, r);
    case 'developer':      // circle
      return `<circle cx="${cx}" cy="${cy}" r="${r}"/>`;
    case 'cwa-action':     // diamond
      return `<polygon points="${cx},${cy-r*1.25} ${cx+r*1.25},${cy} ${cx},${cy+r*1.25} ${cx-r*1.25},${cy}"/>`;
    case 'community':      // rounded square
      return `<rect x="${cx-r*.9}" y="${cy-r*.9}" width="${r*1.8}" height="${r*1.8}" rx="2.5"/>`;
    case 'protection':     // triangle (shield)
      return `<polygon points="${cx},${cy-r*1.3} ${cx+r*1.3},${cy+r*.9} ${cx-r*1.3},${cy+r*.9}"/>`;
    case 'legal':          // hexagon
      return hexPath(cx, cy, r);
    case 'cwa-terminated': // X
      return xPath(cx, cy, r);
    case 'future':         // dashed circle
      return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke-width="2" stroke-dasharray="4,3"/>`;
    case 'surveillance':   // eye (two overlapping circles)
      return `<circle cx="${cx}" cy="${cy}" r="${r*1.2}" fill="none" stroke-width="2"/><circle cx="${cx}" cy="${cy}" r="${r*0.45}"/>`;
    case 'immigration':    // pentagon
      return pentagonPath(cx, cy, r);
    case 'meeting':        // calendar (outlined square with header line)
      return `<rect x="${cx-r*1.1}" y="${cy-r*1.1}" width="${r*2.2}" height="${r*2.2}" rx="1.5" fill="none" stroke-width="2"/><line x1="${cx-r*1.1}" y1="${cy-r*0.3}" x2="${cx+r*1.1}" y2="${cy-r*0.3}" stroke-width="2"/>`;
    default:
      return `<circle cx="${cx}" cy="${cy}" r="${r}"/>`;
  }
}

function starPath(cx, cy, r) {
  const pts = [];
  for (let i = 0; i < 10; i++) {
    const a = (i * 36 - 90) * Math.PI / 180;
    const rr = i % 2 === 0 ? r * 1.15 : r * 0.48;
    pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
  }
  return `<polygon points="${pts.join(' ')}"/>`;
}

function pentagonPath(cx, cy, r) {
  const pts = [];
  for (let i = 0; i < 5; i++) {
    const a = (i * 72 - 90) * Math.PI / 180;
    pts.push(`${(cx + r * 1.15 * Math.cos(a)).toFixed(1)},${(cy + r * 1.15 * Math.sin(a)).toFixed(1)}`);
  }
  return `<polygon points="${pts.join(' ')}"/>`;
}

function hexPath(cx, cy, r) {
  const pts = [];
  for (let i = 0; i < 6; i++) {
    const a = (i * 60 - 30) * Math.PI / 180;
    pts.push(`${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`);
  }
  return `<polygon points="${pts.join(' ')}"/>`;
}

function xPath(cx, cy, r) {
  const s = r * 0.78, sw = r * 0.4;
  return `
    <line x1="${cx-s}" y1="${cy-s}" x2="${cx+s}" y2="${cy+s}" stroke-width="${sw}" stroke-linecap="round"/>
    <line x1="${cx+s}" y1="${cy-s}" x2="${cx-s}" y2="${cy+s}" stroke-width="${sw}" stroke-linecap="round"/>
  `;
}

// ─────────────────────────────────────────────
//  STATE
// ─────────────────────────────────────────────
const activeTypes = new Set(Object.keys(TYPES));
const LANE_H = 148;
const TODAY = new Date().toISOString().slice(0, 10);

// ─────────────────────────────────────────────
//  LEGEND
// ─────────────────────────────────────────────
function buildLegend() {
  const el = document.getElementById('legend');
  el.innerHTML = '<span class="legend-heading">Filter by:</span>';
  Object.entries(TYPES).forEach(([key, meta]) => {
    const item = document.createElement('div');
    item.className = 'leg-item';
    item.dataset.key = key;
    item.innerHTML = `<div class="leg-dot" style="background:${meta.color}"></div><span class="leg-label">${meta.label}</span>`;
    item.addEventListener('click', () => {
      if (activeTypes.has(key)) { activeTypes.delete(key); item.classList.add('off'); }
      else                       { activeTypes.add(key);    item.classList.remove('off'); }
      renderChart();
    });
    el.appendChild(item);
  });
}

// ─────────────────────────────────────────────
//  SMART STAGGER — avoid label collisions
// ─────────────────────────────────────────────
function stagger(events, svgWidth) {
  // Returns array of { event, x, dotY, labelAnchor, labelSide }
  // dotY: above or below midline; labelSide: 'above' or 'below'
  const MID = LANE_H / 2;
  const DOT_OFFSET = 20;   // px from midline to dot center
  const MIN_GAP    = 72;   // min px between events on same side before forcing flip

  // Sort by date
  const sorted = events
    .filter(e => activeTypes.has(e.type))
    .sort((a, b) => parseDate(a.date) - parseDate(b.date));

  const lastX = { above: -Infinity, below: -Infinity };

  return sorted.map((ev, i) => {
    const x = toX(ev.date, svgWidth);
    // Try preferred side first (alternate)
    const preferred = i % 2 === 0 ? 'above' : 'below';
    const alt = preferred === 'above' ? 'below' : 'above';

    let side;
    if (x - lastX[preferred] >= MIN_GAP) {
      side = preferred;
    } else if (x - lastX[alt] >= MIN_GAP) {
      side = alt;
    } else {
      // Both sides crowded — pick the one with more room
      side = (x - lastX[preferred] >= x - lastX[alt]) ? preferred : alt;
    }

    lastX[side] = x;
    const dotY = side === 'above' ? MID - DOT_OFFSET : MID + DOT_OFFSET;
    return { ev, x, dotY, side };
  });
}

// ─────────────────────────────────────────────
//  SVG AXIS
// ─────────────────────────────────────────────
function buildAxisSVG(svgWidth) {
  const H = 36;
  let s = [`<svg width="${svgWidth}" height="${H}" xmlns="http://www.w3.org/2000/svg" style="overflow:visible;display:block">`];

  let d = new Date(T_START);
  while (d <= T_END) {
    const x = toX(d.toISOString().slice(0,7), svgWidth);
    const m = d.getMonth();

    if (m === 0) {
      s.push(`<line x1="${x}" y1="0" x2="${x}" y2="${H}" stroke="#475569" stroke-width="1.5"/>`);
      s.push(`<text x="${x+4}" y="13" fill="#94a3b8" font-size="12" font-weight="700" font-family="-apple-system,sans-serif">${d.getFullYear()}</text>`);
    } else if (m % 3 === 0) {
      s.push(`<line x1="${x}" y1="18" x2="${x}" y2="${H}" stroke="#334155" stroke-width="1"/>`);
      const qLabel = ['','Q2','Q3','Q4'][Math.floor(m/3)];
      s.push(`<text x="${x+4}" y="${H-2}" fill="#64748b" font-size="10" font-family="-apple-system,sans-serif">${qLabel}</text>`);
    }

    d.setMonth(d.getMonth() + 1);
  }

  // Today marker
  const tx = toX(TODAY, svgWidth);
  s.push(`<line x1="${tx}" y1="0" x2="${tx}" y2="${H}" stroke="#94a3b8" stroke-width="1" stroke-dasharray="3,3" opacity="0.6"/>`);

  s.push('</svg>');
  return s.join('');
}

// ─────────────────────────────────────────────
//  LANE SVG
// ─────────────────────────────────────────────
function buildLaneSVG(community, svgWidth, communityIdx) {
  const MID = LANE_H / 2;
  const R   = 8;    // marker radius
  const FONT = '-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif';

  const positioned = stagger(community.events, svgWidth);

  let s = [`<svg width="${svgWidth}" height="${LANE_H}" xmlns="http://www.w3.org/2000/svg" style="overflow:visible;display:block">`];

  // Quarterly gridlines
  let d = new Date(T_START);
  while (d <= T_END) {
    if (d.getMonth() % 3 === 0) {
      const gx = toX(d.toISOString().slice(0,7), svgWidth);
      const isYear = d.getMonth() === 0;
      s.push(`<line x1="${gx}" y1="0" x2="${gx}" y2="${LANE_H}" stroke="${isYear ? '#475569' : '#293548'}" stroke-width="${isYear ? 1.5 : 1}"/>`);
    }
    d.setMonth(d.getMonth() + 1);
  }

  // Today line
  const tx = toX(TODAY, svgWidth);
  s.push(`<line x1="${tx}" y1="0" x2="${tx}" y2="${LANE_H}" stroke="#94a3b8" stroke-width="1" stroke-dasharray="3,3" opacity="0.4"/>`);

  // Central axis
  s.push(`<line x1="0" y1="${MID}" x2="${svgWidth}" y2="${MID}" stroke="#475569" stroke-width="1.5"/>`);

  // Events
  positioned.forEach(({ ev, x, dotY, side }, i) => {
    const meta = TYPES[ev.type];
    const col  = meta.color;
    const above = side === 'above';
    const labelY = above ? dotY - R - 6 : dotY + R + 16;
    const stemY1 = above ? MID - 2 : MID + 2;

    // Connector stem
    s.push(`<line x1="${x}" y1="${stemY1}" x2="${x}" y2="${dotY + (above ? R+1 : -(R+1))}" stroke="${col}" stroke-width="1.5" opacity="0.55"/>`);

    // Hit target (invisible, larger area)
    s.push(`<circle cx="${x}" cy="${dotY}" r="${R+7}" fill="transparent" class="ev-hit" data-ci="${communityIdx}" data-ei="${i}" style="cursor:pointer"/>`);

    // NEW-entry ring (pulsing gold outline behind the marker)
    if (ev.isNew) {
      s.push(`<circle cx="${x}" cy="${dotY}" r="${R+5.5}" fill="none" stroke="#fbbf24" stroke-width="2" stroke-dasharray="3,2.5" class="new-ring"/>`);
    }

    // Shape marker
    const isX = ev.type === 'cwa-terminated';
    const isFuture = ev.type === 'future';
    if (isX) {
      s.push(`<g fill="none" stroke="${col}">${shape(ev.type, x, dotY, R)}</g>`);
    } else if (isFuture) {
      s.push(`<g fill="none" stroke="${col}">${shape(ev.type, x, dotY, R)}</g>`);
    } else {
      s.push(`<g fill="${col}" stroke="${col}" stroke-width="1">${shape(ev.type, x, dotY, R)}</g>`);
    }

    // Label (short, two lines max)
    const labelPrefix = ev.isNew ? '🆕 ' : '';
    const words = (labelPrefix + ev.label).replace(/[✓⚠]/g,'').trim().split(' ');
    const LINE_MAX = 22;
    let lines = [], cur = '';
    words.forEach(w => {
      if ((cur + ' ' + w).trim().length <= LINE_MAX) cur = (cur + ' ' + w).trim();
      else { if (cur) lines.push(cur); cur = w; }
    });
    if (cur) lines.push(cur);
    lines = lines.slice(0, 2); // max 2 lines

    if (above) {
      // labels go up, so first line is higher
      lines.reverse().forEach((line, li) => {
        const ly = dotY - R - 7 - li * 12;
        s.push(`<text x="${x}" y="${ly}" text-anchor="middle" fill="#94a3b8" font-size="9.5" font-family="${FONT}">${line}</text>`);
      });
    } else {
      lines.forEach((line, li) => {
        const ly = dotY + R + 13 + li * 12;
        s.push(`<text x="${x}" y="${ly}" text-anchor="middle" fill="#94a3b8" font-size="9.5" font-family="${FONT}">${line}</text>`);
      });
    }
  });

  s.push('</svg>');
  return { svg: s.join(''), positioned };
}

// ─────────────────────────────────────────────
//  TOOLTIP
// ─────────────────────────────────────────────
const ttEl = document.getElementById('tt');
let ttVisible = false;
let ttPinned = false;
let ttPinnedKey = null;

// Store reference: communityIdx → positioned[]
const laneData = [];

function showTT(e, ev, pinned) {
  const meta = TYPES[ev.type];
  const sourceHtml = ev.source
    ? `<div class="tt-source">🔗 <a href="${ev.source}" target="_blank" rel="noopener">${ev.sourceLabel || 'Source'}</a></div>`
    : '';
  const pinHint = pinned
    ? `<div class="tt-pin-hint">Pinned — click the dot again, or click elsewhere, to close.</div>`
    : (ev.source ? `<div class="tt-pin-hint">Click the dot to pin this card and open the link.</div>` : '');
  const newBadge = ev.isNew ? `<span class="tt-new-badge">NEW</span>` : '';
  ttEl.innerHTML = `
    <div class="tt-type" style="color:${meta.color}">${newBadge}${meta.label}</div>
    <div class="tt-label">${ev.label}</div>
    <div class="tt-date">${fmtDate(ev.date)}</div>
    <div class="tt-detail">${ev.detail}</div>
    ${sourceHtml}
    ${pinHint}
  `;
  ttEl.classList.add('show');
  ttEl.classList.toggle('pinned', !!pinned);
  ttVisible = true;
  if (!pinned) placeTT(e);
}

function placeTT(e) {
  const W = 330, H = 200;
  const vw = window.innerWidth, vh = window.innerHeight;
  let l = e.clientX + 16, t = e.clientY + 16;
  if (l + W > vw - 8) l = e.clientX - W - 16;
  if (t + H > vh - 8) t = e.clientY - H - 16;
  ttEl.style.left = l + 'px';
  ttEl.style.top  = t + 'px';
}

document.addEventListener('mousemove', e => { if (ttVisible && !ttPinned) placeTT(e); });

// Event delegation on chart area
document.getElementById('chart').addEventListener('mouseover', e => {
  if (ttPinned) return;
  const hit = e.target.closest('.ev-hit');
  if (!hit) return;
  const ci = +hit.dataset.ci;
  const ei = +hit.dataset.ei;
  const positioned = laneData[ci];
  if (positioned && positioned[ei]) showTT(e, positioned[ei].ev, false);
});

document.getElementById('chart').addEventListener('mouseout', e => {
  if (ttPinned) return;
  if (!e.target.closest('.ev-hit')) return;
  ttEl.classList.remove('show');
  ttVisible = false;
});

// Click a dot to pin its card open (so the source link becomes clickable)
document.getElementById('chart').addEventListener('click', e => {
  const hit = e.target.closest('.ev-hit');
  if (!hit) {
    if (ttPinned) { ttPinned = false; ttPinnedKey = null; ttEl.classList.remove('show', 'pinned'); ttVisible = false; }
    return;
  }
  const ci = +hit.dataset.ci;
  const ei = +hit.dataset.ei;
  const key = ci + ':' + ei;
  const positioned = laneData[ci];
  if (!positioned || !positioned[ei]) return;
  if (ttPinned && ttPinnedKey === key) {
    ttPinned = false; ttPinnedKey = null; ttEl.classList.remove('show', 'pinned'); ttVisible = false;
  } else {
    ttPinned = true; ttPinnedKey = key;
    showTT(e, positioned[ei].ev, true);
  }
  e.stopPropagation();
});

// Clicking the tooltip itself (e.g. selecting text) shouldn't close it
ttEl.addEventListener('click', e => e.stopPropagation());

// ─────────────────────────────────────────────
//  RENDER
// ─────────────────────────────────────────────
function renderChart() {
  const chart = document.getElementById('chart');
  chart.innerHTML = '';
  laneData.length = 0;

  // Width is driven by the actual date range (not the viewport) so the chart can be
  // genuinely wider than the screen and scroll horizontally via .scroll-wrap, instead of
  // being squeezed to fit — which was clipping/hiding events near the left and right edges.
  const totalMonths = (T_END.getFullYear() - T_START.getFullYear()) * 12 + (T_END.getMonth() - T_START.getMonth());
  const svgWidth = Math.max(960, totalMonths * PX_PER_MONTH);

  // Give the timeline column an explicit pixel width instead of "1fr". A flex/grid
  // fraction track can never exceed the width available inside .scroll-wrap, so the
  // wide SVGs were being clipped by .lane-body's overflow:hidden instead of pushing
  // .chart-area wider than the viewport — which is what .scroll-wrap's overflow-x:auto
  // needs in order to actually show a scrollbar and let the timeline scroll.
  chart.style.gridTemplateColumns = `200px ${svgWidth + 12}px`;

  // Axis row
  const axisSpacerDiv = document.createElement('div');
  axisSpacerDiv.className = 'axis-spacer';

  const axisWrap = document.createElement('div');
  axisWrap.className = 'axis-svg-wrap';
  axisWrap.style.paddingLeft = '12px';
  axisWrap.innerHTML = buildAxisSVG(svgWidth);

  chart.appendChild(axisSpacerDiv);
  chart.appendChild(axisWrap);

  // Swimlanes
  COMMUNITIES.forEach((com, ci) => {
    const { svg, positioned } = buildLaneSVG(com, svgWidth, ci);
    laneData.push(positioned);

    const header = document.createElement('div');
    header.className = 'lane-header';
    header.innerHTML = `
      <div class="lh-county">${com.county}</div>
      <div class="lh-name">${com.name}</div>
      <div class="lh-planner">${com.planner}</div>
      <div class="lh-title">${com.title}</div>
      <div class="lh-status ${com.cwaStatus}">${com.statusLabel}</div>
    `;

    const body = document.createElement('div');
    body.className = 'lane-body';
    body.style.paddingLeft = '12px';
    body.innerHTML = svg;

    chart.appendChild(header);
    chart.appendChild(body);
  });

  lastSvgWidth = svgWidth;
  if (!hasScrolledToToday) {
    scrollToCurrentQuarter(svgWidth);
    hasScrolledToToday = true;
  }
  updateTopScrollbar();
}

// ─────────────────────────────────────────────
//  AUTO-SCROLL TO CURRENT QUARTER
// ─────────────────────────────────────────────
let hasScrolledToToday = false;
let lastSvgWidth = 0;

function scrollToCurrentQuarter(svgWidth) {
  const wrap = document.querySelector('.scroll-wrap');
  if (!wrap) return;
  const HEADER_W = 200; // sticky lane-header column width, always visible on the left
  const PAD_L = 12;     // matches axisWrap/lane-body's inline padding-left

  const now = new Date();
  const qStartMonth = Math.floor(now.getMonth() / 3) * 3;
  const qStart = new Date(now.getFullYear(), qStartMonth, 1);
  const qEnd = new Date(now.getFullYear(), qStartMonth + 3, 1);
  const xStart = toX(qStart.toISOString().slice(0, 10), svgWidth);
  const xEnd = toX(qEnd.toISOString().slice(0, 10), svgWidth);
  const qCenterAbs = HEADER_W + PAD_L + (xStart + xEnd) / 2;

  const visibleTimelineWidth = Math.max(0, wrap.clientWidth - HEADER_W);
  let target = qCenterAbs - HEADER_W - (visibleTimelineWidth / 2);
  const maxScroll = Math.max(0, wrap.scrollWidth - wrap.clientWidth);
  wrap.scrollLeft = Math.min(Math.max(0, target), maxScroll);
}

// ─────────────────────────────────────────────
//  TOP SCROLLBAR (sticky proxy for the native one at the bottom of a
//  62-lane, several-thousand-pixel-tall chart, which is otherwise a long
//  scroll away)
// ─────────────────────────────────────────────
const topTrack = document.getElementById('topScrollTrack');
const topThumb = document.getElementById('topScrollThumb');
const jumpTodayBtn = document.getElementById('jumpTodayBtn');

function updateTopScrollbar() {
  const wrap = document.querySelector('.scroll-wrap');
  if (!wrap || !topTrack || !topThumb) return;
  const trackW = topTrack.clientWidth;
  const ratio = wrap.clientWidth / wrap.scrollWidth;
  const thumbW = Math.max(24, trackW * Math.min(1, ratio));
  const maxScroll = Math.max(1, wrap.scrollWidth - wrap.clientWidth);
  const maxThumbX = Math.max(0, trackW - thumbW);
  const thumbX = maxScroll > 0 ? (wrap.scrollLeft / maxScroll) * maxThumbX : 0;
  topThumb.style.width = thumbW + 'px';
  topThumb.style.left = thumbX + 'px';
}

function scrollWrapFromThumbX(thumbX) {
  const wrap = document.querySelector('.scroll-wrap');
  const trackW = topTrack.clientWidth;
  const thumbW = topThumb.offsetWidth;
  const maxThumbX = Math.max(0, trackW - thumbW);
  const maxScroll = Math.max(0, wrap.scrollWidth - wrap.clientWidth);
  const clampedX = Math.min(Math.max(0, thumbX), maxThumbX);
  wrap.scrollLeft = maxThumbX > 0 ? (clampedX / maxThumbX) * maxScroll : 0;
}

if (topThumb && topTrack) {
  let dragging = false;
  let dragStartX = 0;
  let dragStartLeft = 0;

  topThumb.addEventListener('pointerdown', (e) => {
    dragging = true;
    dragStartX = e.clientX;
    dragStartLeft = topThumb.offsetLeft;
    topThumb.classList.add('dragging');
    topThumb.setPointerCapture(e.pointerId);
    e.preventDefault();
  });
  topThumb.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    scrollWrapFromThumbX(dragStartLeft + (e.clientX - dragStartX));
  });
  ['pointerup', 'pointercancel'].forEach(evt => {
    topThumb.addEventListener(evt, () => {
      dragging = false;
      topThumb.classList.remove('dragging');
    });
  });

  topTrack.addEventListener('pointerdown', (e) => {
    if (e.target === topThumb) return; // handled by the thumb's own listener
    const rect = topTrack.getBoundingClientRect();
    scrollWrapFromThumbX(e.clientX - rect.left - topThumb.offsetWidth / 2);
  });
}

if (jumpTodayBtn) {
  jumpTodayBtn.addEventListener('click', () => {
    scrollToCurrentQuarter(lastSvgWidth || 960);
    updateTopScrollbar();
  });
}

document.querySelector('.scroll-wrap').addEventListener('scroll', updateTopScrollbar);
window.addEventListener('resize', updateTopScrollbar);

// ─────────────────────────────────────────────
//  THIS WEEK AT A GLANCE
//  Mon–Fri grid built fresh from COMMUNITIES on every load, so it never
//  goes stale the way a hand-written date range would. If today falls on
//  a weekend, it jumps ahead to the coming Monday; otherwise it shows the
//  week already in progress.
// ─────────────────────────────────────────────
function miniIcon(type) {
  const meta = TYPES[type] || { color: '#94a3b8' };
  return `<svg class="week-event-icon" width="14" height="14" viewBox="0 0 14 14" fill="${meta.color}" stroke="${meta.color}">${shape(type, 7, 7, 4.5)}</svg>`;
}

function buildWeekSection() {
  const grid = document.getElementById('weekGrid');
  if (!grid) return;

  // Filter out the blanket "nothing found here" entries logged during research
  // sweeps — those aren't events, just an audit trail that a day was checked.
  const boilerplate = [
    'No documented data-center activity',
    'CWA client — no data-center proposal, moratorium, or ordinance found',
    'completeness sweep'
  ];

  const now = new Date();
  const dow = now.getDay(); // 0=Sun ... 6=Sat
  let offsetToMonday;
  if (dow === 0) offsetToMonday = 1;
  else if (dow === 6) offsetToMonday = 2;
  else offsetToMonday = 1 - dow;
  const monday = new Date(now.getFullYear(), now.getMonth(), now.getDate() + offsetToMonday);
  const todayStr = new Date().toISOString().slice(0, 10);
  const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];

  let html = '';
  for (let i = 0; i < 5; i++) {
    const d = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + i);
    const dateStr = d.toISOString().slice(0, 10);
    const dateLabel = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });

    let dayEvents = [];
    COMMUNITIES.forEach(c => {
      c.events.forEach(e => {
        if (e.date === dateStr && !boilerplate.some(b => e.label.includes(b))) {
          dayEvents.push({ name: c.name, ...e });
        }
      });
    });
    dayEvents.sort((a, b) => a.name.localeCompare(b.name));

    const isToday = dateStr === todayStr;
    html += `<div class="week-day-card${isToday ? ' is-today' : ''}">`;
    html += `<div class="week-day-name">${dayNames[i]}</div>`;
    html += `<div class="week-day-date">${dateLabel}</div>`;
    if (dayEvents.length === 0) {
      html += `<div class="week-empty">No meetings currently listed</div>`;
    } else {
      html += `<ul class="week-event-list">`;
      dayEvents.forEach(e => {
        const icon = miniIcon(e.type);
        const text = e.source
          ? `<a href="${e.source}" target="_blank" rel="noopener">${e.label}</a>`
          : e.label;
        const packetLink = e.packet
          ? ` <a href="${e.packet}" target="_blank" rel="noopener" class="week-packet-link" title="Meeting agenda/packet">📄 Packet</a>`
          : (e.packetChecked ? ` <span class="week-packet-missing">(packet not posted yet)</span>` : '');
        const alertHtml = e.alertNote
          ? `<div class="week-alert">⚠️ ${e.alertNote}</div>`
          : '';
        html += `<li class="week-event-item">${icon}<span class="week-event-text"><b>${e.name}:</b> ${text}${packetLink}${alertHtml}</span></li>`;
      });
      html += `</ul>`;
    }
    html += `</div>`;
  }
  grid.innerHTML = html;
